# Fleet-wide settings — identical on every vehicle. Shipped in the package and
# updated by installing a new version, not by editing vehicles one by one.
#
# Installed to /etc/bullwork-livestream/fleet.env
#
# Every value here is real except PROVISION_TOKEN, which is filled in at
# install time. See the note beside it.

# ---- where this vehicle's own identity comes from ------------------------
# The only per-vehicle value is VID. Anything set in this file overrides what
# is below.
VEHICLE_ENV_FILE=/home/bullwork/.env_vars


# ---- server ---------------------------------------------------------------
# Nothing about MQTT is set here. The agent reads the broker, credentials and
# vehicle id straight out of the vehicle's existing .env_vars:
#   VEHICLE_ID -> VID          MQTT_BROKER_HOST -> MQTT_HOST
#   MQTT_USERNAME -> MQTT_USER MQTT_BROKER_PORT -> MQTT_PORT
#   MQTT_PASSWORD -> MQTT_PASS (TLS is implied by port 8883)
# The agent connects with its own client id (<MQTT_CLIENT_ID>-livestream) so it
# does not collide with the vehicle's main MQTT session.

# The vehicle asks for its own publish URL using its VID, so WHIP_URL and
# PUBLISH_TOKEN are never set per vehicle.
STREAM_API_URL=http://136.111.165.61:8095

# Left empty on purpose, and the package must not ship it filled in.
#
# This one token can start, stop and watch every vehicle in the fleet. In a
# git repository it would be permanent: removing it in a later commit leaves
# it in the history, readable by anyone who clones. One of these was already
# exposed once, through a file server that was publishing the directory it
# ran in.
#
# Fill it at install time instead, from wherever the platform keeps its
# secrets:
#
#   sudo sed -i "s|^PROVISION_TOKEN=.*|PROVISION_TOKEN=$TOKEN|" \
#        /etc/bullwork-livestream/fleet.env
#   sudo supervisorctl restart bullwork-livestream
#
# Or export PROVISION_TOKEN in the environment the supervisor program runs
# under, which keeps it off disk entirely.
PROVISION_TOKEN=

# ---- control ---------------------------------------------------------------
# Start and stop arrive on a ROS topic, republished from MQTT by the vehicle's
# existing bridge. The agent opens no broker connection of its own.
CONTROL=ros
LIVESTREAM_CONTROL_TOPIC=/livestream_control
# Pinned rather than detected: at boot nothing is publishing to the topic yet,
# so detection falls back to Bool and silently fails to match a String.
LIVESTREAM_CONTROL_TYPE=std_msgs/msg/String
RESTART_GAP_MS=600

# ---- media ----------------------------------------------------------------
STUN_SERVER=stun://stun.l.google.com:19302
# Empty: vehicles reach the server over the NetBird overlay, so NAT traversal
# is handled at the network layer and ICE connects on host candidates alone.
# Measured: STUN only, no TURN, 0.00-0.05% loss.
TURN_SERVER=
ICE_GATHER_TIMEOUT_S=10
# Send the offer once candidates exist rather than waiting for gathering to
# complete, which is a STUN round trip and about 2 s on every start.
ICE_SETTLE_MS=400

SOURCE=ros
# The segmenter's relay, never a ZED topic directly: a second DDS subscriber
# on the ZED image collapses delivery for every consumer, measured at ~27 Hz
# with one and 1.4-2.6 Hz with two.
ZED_TOPIC=/traversability_segmenter/relay/image
ZED_TOPIC_COMPRESSED=
CMD_VEL_TOPIC=/cmd_vel

# Measured: 960x600 at ~10 fps is what the relay delivers. WIDTH and HEIGHT
# apply to the test and uvc sources only — a ROS frame carries its own size.
WIDTH=1280
HEIGHT=720
FPS=15
# 1200 held 0.00% loss. 2500 pushed ~1.8 Mbps up the mobile link and brought
# loss to 0.2%, which grew the viewer's jitter buffer and cost more latency
# than the extra bitrate was worth.
BITRATE_KBPS=1200
# Keyframe period in seconds. The encoder counts frames, so this is converted
# using the rate frames actually arrive at, not the configured FPS.
KEYFRAME_EVERY_S=2
CLOCK_OVERLAY=false

# ---- faults ----------------------------------------------------------------
# Publishing with no frame for this long means the camera has stopped. The
# WebRTC session stays healthy, so nothing else can detect it.
FRAME_STALL_S=5
FIRST_FRAME_WAIT_S=10
RECONNECT_MAX_TRIES=6
RECONNECT_BASE_S=2

# ---- teleop limits --------------------------------------------------------
MAX_LIN=1.0
MAX_ANG=1.5
DEADMAN_S=0.5

# ---- ROS ------------------------------------------------------------------
# Sourced before the agent starts, or rclpy will not import.
ROS_SETUP=/opt/ros/humble/setup.bash
